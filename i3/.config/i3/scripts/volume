#!/usr/bin/env bash
# i3blocks volume block for PipeWire (PulseAudio compatible)
set -euo pipefail

STEP=${1:-5%}
ACTIVE_COLOR="${ACTIVE_COLOR:-#ae81ff}"
MUTED_COLOR="${MUTED_COLOR:-#a6a696}"
ERROR_COLOR="${ERROR_COLOR:-#ff2d6f}"

# Handle clicks
case "${BLOCK_BUTTON:-}" in
    1) command -v pavucontrol >/dev/null 2>&1 && pavucontrol ;; # left click = mixer UI
    2)
        if command -v wpctl >/dev/null 2>&1; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1 || true
        else
            SINK="$(pactl info 2>/dev/null | awk '/Default Sink/ {print $3}' || true)"
            [[ -n "${SINK}" ]] && pactl set-sink-mute "$SINK" toggle >/dev/null 2>&1 || true
        fi
        ;;
    3)
        if command -v wpctl >/dev/null 2>&1; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1 || true
        else
            SINK="$(pactl info 2>/dev/null | awk '/Default Sink/ {print $3}' || true)"
            [[ -n "${SINK}" ]] && pactl set-sink-mute "$SINK" toggle >/dev/null 2>&1 || true
        fi
        ;;
    4)
        if command -v wpctl >/dev/null 2>&1; then
            wpctl set-volume @DEFAULT_AUDIO_SINK@ +"${STEP}" >/dev/null 2>&1 || true
        else
            SINK="$(pactl info 2>/dev/null | awk '/Default Sink/ {print $3}' || true)"
            [[ -n "${SINK}" ]] && pactl set-sink-volume "$SINK" +$STEP >/dev/null 2>&1 || true
        fi
        ;;
    5)
        if command -v wpctl >/dev/null 2>&1; then
            wpctl set-volume @DEFAULT_AUDIO_SINK@ -"${STEP}" >/dev/null 2>&1 || true
        else
            SINK="$(pactl info 2>/dev/null | awk '/Default Sink/ {print $3}' || true)"
            [[ -n "${SINK}" ]] && pactl set-sink-volume "$SINK" -$STEP >/dev/null 2>&1 || true
        fi
        ;;
esac

# Get current volume + mute state (prefer PipeWire native tool)
VOL=""
MUTED="no"
if command -v wpctl >/dev/null 2>&1; then
    wp_out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
    if [[ -n "${wp_out}" ]]; then
        vol_float="$(awk '{print $2}' <<< "${wp_out}" || true)"
        if [[ "${vol_float}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            VOL="$(awk -v v="${vol_float}" 'BEGIN { printf "%.0f", v*100 }')"
        fi
        grep -q "MUTED" <<< "${wp_out}" && MUTED="yes"
    fi
fi

if [[ -z "${VOL}" ]]; then
    SINK="$(pactl info 2>/dev/null | awk '/Default Sink/ {print $3}' || true)"
    if [[ -n "${SINK}" ]]; then
        VOL="$(pactl list sinks 2>/dev/null | awk -v s="$SINK" '
            $0 ~ "Name: " s {found=1}
            found && /Volume:/ {gsub("%","",$5); print $5; exit}
        ' || true)"
        MUTED="$(pactl list sinks 2>/dev/null | awk -v s="$SINK" '
            $0 ~ "Name: " s {found=1}
            found && /Mute:/ {print $2; exit}
        ' || true)"
    fi
fi

if [[ -z "${VOL}" ]]; then
    echo "No audio"
    echo "No audio"
    echo "$ERROR_COLOR"
    exit 0
fi

# Choose symbol
AUDIO_HIGH=''
AUDIO_MED=''
AUDIO_LOW=''
AUDIO_MUTED='x'
MED_THRESH=50
LOW_THRESH=0
COLOR="$ACTIVE_COLOR"

if [[ -z "${VOL}" || ! "${VOL}" =~ ^[0-9]+$ ]]; then
    VOL=0
fi
if [[ -z "${MUTED}" ]]; then
    MUTED="no"
fi

if [[ "$MUTED" == "no" ]]; then
    SYMB=$AUDIO_HIGH
    [[ $VOL -le $MED_THRESH ]] && SYMB=$AUDIO_MED
    [[ $VOL -le $LOW_THRESH ]] && SYMB=$AUDIO_LOW
else
    SYMB=$AUDIO_MUTED
    COLOR="$MUTED_COLOR"
fi

# i3blocks output (full_text, short_text, color)
echo "${SYMB} ${VOL}%"
echo "${SYMB} ${VOL}%"
echo "${COLOR}"
