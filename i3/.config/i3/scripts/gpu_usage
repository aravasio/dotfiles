#!/usr/bin/env bash

notify_integrated() {
  if [[ -n "${BLOCK_BUTTON:-}" ]]; then
    notify-send "Integrated graphics active" "You are using your integrated graphics."
  fi
}

if command -v nvidia-smi >/dev/null 2>&1; then
  usage=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)
  if [[ -n "${usage}" ]]; then
    echo "${usage}%"
    echo "${usage}%"
    echo "#00ff00"
    exit 0
  fi
fi

notify_integrated

echo "!"
echo "!"
echo "#ff0000"
