#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/i3-theme"
mkdir -p "$state_dir"
state_file="$state_dir/theme-set"

# Avoid reload loops: only set once per session.
if [[ -f "$state_file" ]]; then
  exit 0
fi

themes_dir="$HOME/.config/i3/themes"
if [[ ! -d "$themes_dir" ]]; then
  exit 0
fi

mapfile -t themes < <(find "$themes_dir" -maxdepth 1 -type f -name '*.conf' -print)
if [[ ${#themes[@]} -eq 0 ]]; then
  exit 0
fi

pick="${themes[RANDOM % ${#themes[@]}]}"
cfg="$HOME/.config/i3/config"
if [[ ! -f "$cfg" ]]; then
  exit 0
fi

# Replace THEME BLOCK in config (safe replacement)
THEME_PICK="$pick" python3 - <<'PY'
import os, sys

cfg = os.path.expanduser("~/.config/i3/config")
pick = os.environ.get("THEME_PICK")
if not pick or not os.path.exists(pick):
    sys.exit(0)

with open(pick, "r", encoding="utf-8") as f:
    block = f.read().strip()

with open(cfg, "r", encoding="utf-8") as f:
    data = f.read()

start = "# THEME BLOCK START\n"
end = "# THEME BLOCK END"
if start not in data or end not in data:
    sys.exit(0)

pre, rest = data.split(start, 1)
_, post = rest.split(end, 1)
new_data = pre + start + block + "\n" + end + post

with open(cfg, "w", encoding="utf-8") as f:
    f.write(new_data)
PY

# Mark as set and reload once to apply.
touch "$state_file"
i3-msg reload >/dev/null 2>&1 || true
