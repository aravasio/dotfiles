class SDL_Rect(C.Structure):
    _fields_ = [("x", C.c_int), ("y", C.c_int), ("w", C.c_int), ("h", C.c_int)]

class SDL_Point(C.Structure):
    _fields_ = [("x", C.c_int), ("y", C.c_int)]


def sd(name, restype, *args):
    f = getattr(SDL, name)
    f.restype = restype
    f.argtypes = args
    return f


sd("SDL_GL_GetDrawableSize", None, C.c_void_p, C.POINTER(C.c_int), C.POINTER(C.c_int))
sd("SDL_GetWindowPosition", None, C.c_void_p, C.POINTER(SDL_Point))
sd("SDL_ShowWindow", None, C.c_void_p)
