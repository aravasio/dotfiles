def gl(name, restype, *args):
    addr = SDL.SDL_GL_GetProcAddress(name.encode())
    if not addr:
        raise RuntimeError("GL missing: " + name)
    return C.CFUNCTYPE(restype, *args)(addr)


GL_FLOAT = 0x1406
GL_HALF_FLOAT = 0x140B
GL_TRIANGLES = 0x0004
GL_TRIANGLE_STRIP = 0x0005
GL_LINES = 0x0001
GL_POINTS = 0x0000
