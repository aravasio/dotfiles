#!/bin/bash
# q — quick question to local LLM
# Modes:
#   q "question"            — terminal: stream answer
#   q --show "question"     — one-shot: glow + less
#   q --chat "first q"      — interactive REPL (keep asking)
#   q --chat                — interactive REPL, prompt first

set -euo pipefail
MODEL="${Q_MODEL:-qwen3:8b}"

SHOW=false; CHAT=false
case "${1:-}" in
    --show) SHOW=true; shift ;;
    --chat) CHAT=true; shift ;;
esac

# ── question ──
if [ $# -eq 0 ]; then
    if $CHAT; then
        # chat mode: no first question yet
        :
    else
        QUESTION=$(rofi -dmenu -p "Q" -theme ~/.config/rofi/rofidmenu.rasi) || exit 1
        [ -z "$QUESTION" ] && exit 1
    fi
else
    QUESTION="$*"
fi

command -v jq >/dev/null 2>&1 || { echo "jq required"; exit 1; }

# ── context ──
CTX="alitoh@endeavouros (Arch Linux)
Kernel: $(uname -r)
WM: i3 ($(grep -c bindsym ~/.config/i3/config) binds)
Terminal: kitty  Shell: zsh

$(head -c 4000 ~/.config/machine-facts/AGENTS.md 2>/dev/null || true)"

SYS_MSG="Help alitoh with Linux/system questions. Concise, max 3 paragraphs. Include exact commands.

System:
$CTX"

# ──────────────────────────────────────────────────
#  CHAT MODE — interactive REPL
# ──────────────────────────────────────────────────
if $CHAT; then
    exec /home/alitoh/.local/bin/q-chat "$@"
fi

# ──────────────────────────────────────────────────
#  SHOW MODE — one-shot, glow + less
# ──────────────────────────────────────────────────
if $SHOW; then
    RENDERER="${Q_RENDERER:-q-render}"
    command -v "$RENDERER" >/dev/null 2>&1 || RENDERER=glow
    PAYLOAD=$(jq -n --arg m "$MODEL" --arg s "$SYS_MSG" --arg q "$QUESTION" '{
      model: $m, system: $s, prompt: $q, stream: false
    }')
    RESPONSE=$(curl -s --max-time 60 http://localhost:11434/api/generate \
      -H "Content-Type: application/json" -d "$PAYLOAD")
    ANSWER=$(jq -r '.response // "Error: no response"' <<<"$RESPONSE")
    printf '%s\n' "$ANSWER" | "$RENDERER" | less -R
    exit
fi

# ──────────────────────────────────────────────────
#  TERMINAL MODE — stream answer
# ──────────────────────────────────────────────────
if [ -t 1 ]; then
    PAYLOAD=$(jq -n --arg m "$MODEL" --arg s "$SYS_MSG" --arg q "$QUESTION" '{
      model: $m, system: $s, prompt: $q, stream: true
    }')
    printf '\033[1;33m▶\033[0m '
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        c=$(jq -r '.response // empty' <<<"$line" 2>/dev/null)
        [ -n "$c" ] && printf '%s' "$c"
        jq -e '.done' <<<"$line" >/dev/null 2>&1 && break
    done < <(curl -sN --max-time 60 http://localhost:11434/api/generate \
      -H "Content-Type: application/json" -d "$PAYLOAD")
    echo
    exit
fi

# ──────────────────────────────────────────────────
#  NOTIFICATION FALLBACK (no tty, no show, no chat)
# ──────────────────────────────────────────────────
PAYLOAD=$(jq -n --arg m "$MODEL" --arg s "$SYS_MSG" --arg q "$QUESTION" '{
  model: $m, system: $s, prompt: $q, stream: false
}')
RESPONSE=$(curl -s --max-time 60 http://localhost:11434/api/generate \
  -H "Content-Type: application/json" -d "$PAYLOAD")
ANSWER=$(jq -r '.response // "Error: no response"' <<<"$RESPONSE")
TITLE="${QUESTION:0:60}"
[ "${#QUESTION}" -gt 60 ] && TITLE="${TITLE}…"
notify-send -t 15000 "Q: $TITLE" "$ANSWER"